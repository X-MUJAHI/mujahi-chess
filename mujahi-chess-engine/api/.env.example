# Server runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Stockfish 19 binary path (inside Docker container: /usr/local/bin/stockfish)
STOCKFISH_PATH=/usr/local/bin/stockfish

# Stockfish 19 resource configuration (Render Free/Starter: 512 MB RAM)
ENGINE_THREADS=1
ENGINE_HASH_MB=64
ENGINE_DEFAULT_DEPTH=15
ENGINE_MAX_DEPTH=20

# Configurable analysis timeouts (ms). Set ENGINE_TIMEOUT_MS=0 to disable default cutoff if desired.
ENGINE_TIMEOUT_MS=45000
ENGINE_MAX_TIMEOUT_MS=180000
ENGINE_STOP_TIMEOUT_MS=3000
ENGINE_INIT_TIMEOUT_MS=15000

# Bounded request scheduler
ENGINE_MAX_QUEUE=10
DEDUP_CACHE_TTL_MS=30000
DEDUP_CACHE_MAX_ENTRIES=200

# Explicit CORS allowlist (comma-separated origins, e.g. https://mujahi-chess.vercel.app)
# Leave empty during initial smoke testing only; set explicitly for production Vercel deployment.
CORS_ALLOWED_ORIGINS=https://mujahi-chess.vercel.app
# Allow MV3 Chrome/Edge/Firefox extension service workers (chrome-extension://<id>) while still blocking web origins
CORS_ALLOW_EXTENSIONS=true

# IP-based rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=45
TRUST_PROXY=1

# Server-side license verification & move/depth enforcement (Next.js key server)
REQUIRE_LICENSE_KEY=true
KEY_SERVER_URL=https://mujahi-chess.vercel.app
ENGINE_AUTH_SECRET=
KEY_VERIFY_TIMEOUT_MS=5000
AUTH_CACHE_TTL_MS=300000
