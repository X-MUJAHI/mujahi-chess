{
  "background": {
    "service_worker": "engine/mujahi-background.js"
  },
  "content_scripts": [
    {
      "css": [
        "style.css"
      ],
      "js": [
        "engine/mujahi-provider.js",
        "engine.js",
        "ui.js"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://stockfish.online/*",
    "https://mujahi-chess.onrender.com/*",
    "https://xndroid.store/*",
    "https://explorer.lichess.org/*",
    "https://lichess.org/*",
    "https://tablebase.lichess.ovh/*"
  ],
  "key": "",
  "manifest_version": 3,
  "name": "Chess Helper (chess.com) - SuperMode",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "2.1.4",
  "web_accessible_resources": [
    {
      "resources": [
        "images/xndroid.jpg",
        "images/icon.svg",
        "engine/host.html",
        "engine/host.js",
        "engine/stockfish-19-lite-single.js",
        "engine/stockfish-19-lite-single.wasm"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  }
}
